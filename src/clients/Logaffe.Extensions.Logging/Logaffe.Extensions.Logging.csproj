<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Logaffe.Extensions.Logging</PackageId>
    <Description>
      An ILoggerProvider delivering to a logaffe installation, for applications
      that are not on Serilog. It builds the same CLEF from ILogger's message
      template and state.
    </Description>
    <PackageTags>logging;logaffe;ilogger;clef</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Logaffe.Client/Logaffe.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Below the solution's central version on purpose: this package targets
         the LTS, and its floor is what an application on that runtime already
         has rather than what this repository builds against. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="8.0.3" />
  </ItemGroup>

</Project>
