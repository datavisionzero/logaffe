<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../Logaffe.Application/Logaffe.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- For PasswordHasher<T>, which today verifies rather than writes: a hash
         from before ADR 0057 is read by it and rewritten as Argon2id on the next
         successful sign-in. A FrameworkReference costs nothing — the runtime is
         already there and no package is fetched — so it stays for as long as a
         PBKDF2 hash might. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The read side of the log path. The sweep and the write needed none of
         it — a delete answers with a row count and COPY takes a batch — and the
         filtered page is the first work that has rows to turn back into
         entries, which is when ADR 0003 said this would arrive. -->
    <PackageReference Include="Dapper" />
    <!-- Argon2id, which is what a password is hashed with (ADR 0057). -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <!-- The SMTP client behind the mail port (ADR 0053). -->
    <PackageReference Include="MailKit" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Named as well as arriving under the provider above, because the log
         path writes with Npgsql's binary COPY directly (ADR 0003) rather than
         only through EF Core. A dependency that is used by name is declared by
         name. -->
    <PackageReference Include="Npgsql" />
    <!-- Design-time only: this project is its own startup project for
         `dotnet ef`, through the factory in Persistence. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
