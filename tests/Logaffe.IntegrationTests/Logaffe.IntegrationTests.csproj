<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Logaffe.Infrastructure/Logaffe.Infrastructure.csproj" />
    <!-- The composition root itself, so that what sits behind the operator's
         session is asked of a running installation rather than read off a
         registration. -->
    <ProjectReference Include="../../src/Logaffe.Api/Logaffe.Api.csproj" />
    <!-- The package a sender actually holds, so that the wire format between
         the two is asked of both ends at once rather than of a substituted
         handler that would agree with whatever the client sent. -->
    <ProjectReference Include="../../src/clients/Logaffe.Client/Logaffe.Client.csproj" />
    <!-- And the two packages above it, for the same reason: a formatter that
         wrote `@m` would be counted invalid per entry, which no substituted
         handler would ever notice. -->
    <ProjectReference Include="../../src/clients/Logaffe.Serilog/Logaffe.Serilog.csproj" />
    <ProjectReference Include="../../src/clients/Logaffe.Extensions.Logging/Logaffe.Extensions.Logging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
