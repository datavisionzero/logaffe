<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The tag is the version, and it is the only source of one: a release
       passes `-p:Version=` from the tag it was started by, for the image and all
       three packages alike. That single number is load-bearing beyond the
       registry, because a backup manifest records it (ADR 0024), so a build
       that was not started by a tag says so rather than claiming a number
       nobody released. -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>

  <!-- Shared package metadata for the three client packages. Whether a project
       is packable is decided by the project itself. -->
  <PropertyGroup>
    <Authors>datavisionzero</Authors>
    <Product>logaffe</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/datavisionzero/logaffe</PackageProjectUrl>
    <RepositoryUrl>https://github.com/datavisionzero/logaffe</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Each client package carries its own README, which is the page a reader
       lands on at nuget.org and the only description most of them will read.

       Conditioned on the file rather than on `IsPackable`: the project decides
       that, and it decides it after this file has been imported, so a condition
       on it here would always see the default. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
