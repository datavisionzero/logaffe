<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Persistence">
    <!-- What the log path reads with (ADR 0003). EF Core declares the entry
         table and serves none of it; the queries are hand-written because they
         are fitted to the indexes docs/storage.md claims, and this is what turns
         their rows back into entries. -->
    <PackageVersion Include="Dapper" Version="2.1.66" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- The Npgsql provider asks for EF Core 10.0.4 and the design-time package
         for 10.0.10. Pinned to one version so the two do not meet as a runtime
         binding conflict in the test projects, where both arrive. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Pinned above what Microsoft.AspNetCore.OpenApi asks for: its 2.0.0 is
         GHSA-v5pm-xwqc-g5wc, patched in 2.7.5. Transitive pinning is on, so this
         reaches it. Stays on the 2.x line the ASP.NET Core package compiled
         against; drop the pin once that package moves past the advisory. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.6" />
    <!-- The MCP adapter. The protocol is a wire format with a version
         negotiation and a transport, and none of that is product behaviour
         worth hand-writing; the official SDK carries it and the four tools sit
         on top. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Clients">
    <!-- Serilog 4 is the floor: Serilog.Formatting.Compact 3.0.0 asks for it,
         and applications on the runtime these packages target are on it.
         Reversible — supporting Serilog 3.x means multi-targeting against
         Serilog.Formatting.Compact 2.x, and nothing forecloses that. -->
    <!-- The abstraction an application already logs through. The version here
         is what transitive pinning holds the rest of the solution to, where
         Npgsql asks for 10; the package itself overrides it down to the LTS it
         targets, so that an application on .NET 8 is not asked to take .NET 10's
         libraries to use it. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Serilog" Version="4.3.0" />
    <!-- The whole of the sink, really: because the ingestion format is CLEF
         (ADR 0004), pointing this formatter at the endpoint is the integration.
         Never RenderedCompactJsonFormatter, which writes `@m` and would have
         every line counted invalid. -->
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- Starts the composition root in the test process, which is the only way
         to say that an endpoint is behind the door rather than that a line of
         Program.cs says so. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <!-- The factory itself, so that the ILoggerProvider is asked the way an
         application asks it: through a real logging factory with real scopes,
         rather than by calling the provider's own methods. -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- The client half of the same SDK, so that the MCP surface is asked the
         way an agent asks it — a handshake, a tool list and a call over the
         wire — rather than by calling the tool methods directly, which would
         prove nothing about the endpoint. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.1.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

</Project>
